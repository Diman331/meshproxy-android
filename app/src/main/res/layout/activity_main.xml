<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center_horizontal">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="MeshProxy P2P"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_marginBottom="32dp"/>

    <RadioGroup
        android:id="@+x/radioGroupMode"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginBottom="32dp">

        <RadioButton
            android:id="@+x/radioClient"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="@string/title_client"
            android:textSize="18sp"/>

        <RadioButton
            android:id="@+x/radioSource"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/title_source"
            android:textSize="18sp"
            android:layout_marginTop="12dp"/>

        <RadioButton
            android:id="@+x/radioAuto"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/title_auto"
            android:textSize="18sp"
            android:layout_marginTop="12dp"/>
    </RadioGroup>

    <TextView
        android:id="@+x/textViewStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/status_stopped"
        android:textSize="16sp"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:id="@+x/textViewStats"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/traffic_stats"
        android:textSize="14sp"
        android:textColor="#666666"
        android:layout_marginBottom="32dp"/>

    <Button
        android:id="@+x/buttonToggle"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="@string/start_network"
        android:textSize="18sp"/>

</LinearLayout>
